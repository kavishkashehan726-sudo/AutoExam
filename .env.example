# Copy to .env and fill in. Never commit .env.

# --- General ---
APP_ENV=development

# --- Database (Postgres 17 + pgvector) ---
POSTGRES_USER=autoexam
POSTGRES_PASSWORD=autoexam
POSTGRES_DB=autoexam
# Used by the backend outside Docker (Docker Compose overrides it with the `db` host).
DATABASE_URL=postgresql+psycopg://autoexam:autoexam@localhost:5432/autoexam

# --- Redis / RQ ---
REDIS_URL=redis://localhost:6379/0

# --- API ---
# JSON list of allowed browser origins.
CORS_ORIGINS=["http://localhost:3000"]

# --- LLM provider layer (model names live here, never in code) ---
LLM_PROVIDER=gemini
LLM_MODEL=
EMBEDDING_MODEL=
EMBEDDING_DIMENSIONS=768
GEMINI_API_KEY=

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:8000/api
